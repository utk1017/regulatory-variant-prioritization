# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Data (Huge files and generated datasets shouldn't be version controlled)
data/cache/*
!data/cache/.gitkeep
data/outputs/*
!data/outputs/.gitkeep

# Testing
.pytest_cache/
.coverage

# Build artifacts
*.egg-info/
*.egg
dist/
build/
.eggs/

# Jupyter
.ipynb_checkpoints/
